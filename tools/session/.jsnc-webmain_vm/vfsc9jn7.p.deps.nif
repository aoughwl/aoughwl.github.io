(.nif27)
(.vendor "Nifler")
(.dialect "nim-deps")
(stmts
 (import
  (infix / std
   (bracket memfiles syncio times)))
 (import
  (when
   (call defined vfsProfile))
  (infix / std strutils))
 (import
  (when
   (call defined nimony))
  (infix / std
   (bracket os dirs paths)))
 (import
  (when
   (prefix not
    (call defined nimony)))
  (infix / std
   (bracket os))))