(.nif27)
(.vendor "Nifler")
(.dialect "nim-deps")
(stmts
 (import
  (infix / std
   (bracket oserrors)))
 (import
  (infix / std paths))
 (import
  (infix / private oscommons))
 (export PathComponent)
 (export
  (dot paths Path)
  (dot paths path)
  (dot paths
   (quoted /))
  (dot paths
   (quoted $)))
 (import
  (when
   (call defined windows))
  (infix / windows winlean))
 (fromimport
  (when
   (call defined windows))widestrs newWideCString toWideCString
  (quoted $))
 (import
  (when
   (prefix not
    (call defined windows)))
  (infix / posix posix))
 (import
  (when
   (call defined windows))
  (infix / errorcodes errorcodes_windows))
 (import
  (when
   (prefix not
    (call defined windows)))
  (infix / errorcodes errorcodes_posix)))