   (kv rc.0 0)
   (kv capImpl.0 0)
   (kv data.0 "\0A/* ---- aowli JIT shims \28uniform flat-buffer ABI\29 --------------------------- */\0A\23include <stdlib.h>\0A\23include <string.h>\0A/* Byte-loop reads/writes\3A args are tight-packed and may be unaligned. */\0Astatic long long aowli_jit_rd\28const unsigned char* p, int off, int n\29 \7B\0A  unsigned long long v = 0; int i;\0A  for \28i = 0; i < n; i++\29 v |= \28\28unsigned long long\29p\5Boff + i\5D\29 << \288 * i\29;\0A  /* sign-extend so a negative int32/int16/int8 arrives as a negative long long */\0A  if \28n < 8\29 \7B\0A    unsigned long long sign = 1ULL << \288 * n - 1\29;\0A    if \28v & sign\29 v |= \7E\28\281ULL << \288 * n\29\29 - 1ULL\29;\0A  \7D\0A  return \28long long\29v;\0A\7D\0Astatic void aowli_jit_wr\28unsigned char* p, int off, int n, long long v\29 \7B\0A  int i; for \28i = 0; i < n; i++\29 p\5Boff + i\5D = \28unsigned char\29\28\28v >> \288 * i\29\29 & 0xff\29;\0A\7D\0A")))
 (const@B,9i :strlit.0.I7463840659243061209. . LongString.0.sysvq0asl
  (oconstr LongString.0.sysvq0asl
   (kv fullLen.0 1350)
   (kv rc.0 0)
   (kv capImpl.0 0)
   (kv data.0 "\0A/* ---- aowli JIT string marshaling ---------------------------------------- */\0A/* The WHOLE 16-byte struct is the inline buffer\3A byte 0 is the length and bytes\0A   1.. are the data, so `more_0` holds CHARACTERS for a medium string and is not\0A   a discriminator. A length byte above the inline maximum cannot be an inline\0A   length, so that is the \22payload lives in more_0\22 marker \28the compiler emits\0A   254 for a literal and 255 for a heap string\29. Reading `more_0` as a pointer\0A   whenever it was non-zero is what segfaulted on the first COMPUTED 8-byte\0A   string\3A \22<medium>\22 stores \27>\27 \280x3e\29 there.\0A\0A   AND THE MAXIMUM IS 14, NOT 15, however much room the struct looks like it\0A   has. `stringimpl.nim` sets `PayloadSize = \28sizeof\28uint\29 - 1\29 + sizeof\28ptr\29 -\0A   1` = 14 and `len\28\29` reads `more.fullLen` for ANY length byte ABOVE that - so\0A   a 15-byte string written inline here is read back by the runtime as a heap\0A   string whose `more` pointer is its own last eight characters. It dereferences\0A   them. Measured\3A `aoughwl.settings` crossing `stateKey\28s\3A Setting\29`, whose\0A   `key` is \22airAcceleration\22 - fifteen letters - segfaulted inside the shimmed\0A   proc on the first call. Nothing of 0..14 or of 16-and-up was ever wrong,\0A   which is why this survived\3A it is one length. */\0A\23define AOWLI_JIT_INLINE_MAX 14\0A\0Astatic long long aowli_jit_slen\28")))
 (const@j,A4 :strlit.0.I1876279935150955625. . LongString.0.sysvq0asl
  (oconstr LongString.0.sysvq0asl
   (kv fullLen.0 204)
   (kv rc.0 0)
   (kv capImpl.0 0)
   (kv data.0 "* s\29 \7B\0A  unsigned char tag = \28unsigned char\29\28s->bytes_0 & 0xffull\29;\0A  if \28tag > AOWLI_JIT_INLINE_MAX\29 return \28long long\29s->more_0->fullLen_0;\0A  return \28long long\29tag;\0A\7D\0Astatic const char* aowli_jit_sdata\28")))
