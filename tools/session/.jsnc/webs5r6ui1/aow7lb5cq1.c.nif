   (kv capImpl.0 0)
   (kv data.0 "\0A/* ---- aowli JIT string marshaling ---------------------------------------- */\0A/* The WHOLE 16-byte struct is the inline buffer\3A byte 0 is the length and bytes\0A   1..15 are the data, so `more_0` holds CHARACTERS for an 8..15 byte string and\0A   is not a discriminator. A length byte above 15 cannot be an inline length, so\0A   that is the \22payload lives in more_0\22 marker \28the compiler emits 254\29.\0A   Reading `more_0` as a pointer whenever it was non-zero is what segfaulted on\0A   the first COMPUTED 8-byte string\3A \22<medium>\22 stores \27>\27 \280x3e\29 there. */\0A\23define AOWLI_JIT_INLINE_MAX 15\0A\0Astatic long long aowli_jit_slen\28")))
