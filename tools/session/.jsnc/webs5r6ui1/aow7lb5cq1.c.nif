   (kv capImpl.0 0)
   (kv data.0 "\0A/* ---- aowli JIT shims \28uniform flat-buffer ABI\29 --------------------------- */\0A\23include <stdlib.h>\0A\23include <string.h>\0A/* Byte-loop reads/writes\3A args are tight-packed and may be unaligned. */\0Astatic long long aowli_jit_rd\28const unsigned char* p, int off, int n\29 \7B\0A  unsigned long long v = 0; int i;\0A  for \28i = 0; i < n; i++\29 v |= \28\28unsigned long long\29p\5Boff + i\5D\29 << \288 * i\29;\0A  /* sign-extend so a negative int32/int16/int8 arrives as a negative long long */\0A  if \28n < 8\29 \7B\0A    unsigned long long sign = 1ULL << \288 * n - 1\29;\0A    if \28v & sign\29 v |= \7E\28\281ULL << \288 * n\29\29 - 1ULL\29;\0A  \7D\0A  return \28long long\29v;\0A\7D\0Astatic void aowli_jit_wr\28unsigned char* p, int off, int n, long long v\29 \7B\0A  int i; for \28i = 0; i < n; i++\29 p\5Boff + i\5D = \28unsigned char\29\28\28v >> \288 * i\29\29 & 0xff\29;\0A\7D\0A")))
 (const@B,8v :strlit.0.I1797034738989881978. . LongString.0.sysvq0asl
  (oconstr LongString.0.sysvq0asl
