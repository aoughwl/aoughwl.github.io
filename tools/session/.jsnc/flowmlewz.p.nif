(.nif27)
(.vendor "Nifler")
(.dialect "nim-parsed")
(stmts@,1,../../aowli/src/aowli/floatfmt.nim
 (comment)
 (fromimport@,A
  (infix@8 / std~3 strutils@1)formatBiggestFloat@P FloatFormatMode@j ffDefault@2,1 ffDecimal@D,1 ffScientific@O,1)
 (fromimport@,C
  (infix@8 / std~3 parseutils@1)parseBiggestFloat@R)
 (proc@,E fmtBigFloat@5 x . .
