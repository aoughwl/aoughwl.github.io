(.nif27)
(.vendor "Nifler")
(.dialect "nim-parsed")
(stmts@,1,a2.nim
 (var@4 n . . . 0@4)
 (proc@,2 bump@5 . . .
  (params@9). . .
  (stmts@2,1
   (asgn@2 n~2
    (infix@4 \2B n~2 50@2))))
 (proc@,5 read@5 . . .
  (params@9)int@4 . .
  (stmts@J n))
 (asgn@2,7 n~2
  (infix@4 \2B n~2 1@2))
 (asgn@2,8 n~2
  (infix@4 \2B n~2 1@2)))